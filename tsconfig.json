{
  "extends": "@homebound/tsconfig/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "types": ["vitest/globals", "node"],
    "jsx": "react-jsx",
    "module": "Preserve",
    // Let tsup rewrite path-less imports
    "moduleResolution": "bundler",
    // Vite's `resolve.tsconfigPaths` and TS 7 both need explicit `paths` for the `src/*` alias
    "paths": { "src/*": ["./src/*"] },
    "noEmit": true,
    "skipLibCheck": true
  }
}
